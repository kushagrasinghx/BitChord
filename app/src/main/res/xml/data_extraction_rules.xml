<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pexpo_auth.xml" />
        <exclude domain="sharedpref" path="pexpo_auth_plain.xml" />
        <exclude domain="sharedpref" path="pexpo_sources.xml" />
        <exclude domain="sharedpref" path="pexpo_sources_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pexpo_auth.xml" />
        <exclude domain="sharedpref" path="pexpo_auth_plain.xml" />
        <exclude domain="sharedpref" path="pexpo_sources.xml" />
        <exclude domain="sharedpref" path="pexpo_sources_plain.xml" />
    </device-transfer>
</data-extraction-rules>
