<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick Play / Quick Picks Home-Screen Widget.
  Displays a top Now/Last Playing bar with playback controls, plus a 2x4 grid of
  recent and recommended tracks that can be played with a single tap directly
  from the home screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quick_play_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Section: Now / Last Playing Track + Controls -->
        <LinearLayout
            android:id="@+id/widget_top_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_item_placeholder"
                android:contentDescription="@string/widget_artwork"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_quick_play_label"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_like"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_button_pill_bg"
                    android:contentDescription="@string/favorite"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_star" />

                <FrameLayout
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_play_button_bg"
                    android:contentDescription="@string/widget_play"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_play" />

                <FrameLayout
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_button_pill_bg"
                    android:contentDescription="@string/widget_next"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider line -->
        <FrameLayout
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="#1AFFFFFF" />

        <!-- Bottom Grid: Quick Picks (2 rows of 4 items) -->
        <LinearLayout
            android:id="@+id/widget_quick_picks_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1 -->
            <LinearLayout
                android:id="@+id/widget_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Item 0 -->
                <LinearLayout
                    android:id="@+id/quick_pick_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_0_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_0_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Item 1 -->
                <LinearLayout
                    android:id="@+id/quick_pick_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_1_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_1_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Item 2 -->
                <LinearLayout
                    android:id="@+id/quick_pick_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_2_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_2_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Item 3 -->
                <LinearLayout
                    android:id="@+id/quick_pick_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_3_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_3_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/widget_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Item 4 -->
                <LinearLayout
                    android:id="@+id/quick_pick_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_4_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_4_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Item 5 -->
                <LinearLayout
                    android:id="@+id/quick_pick_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_5_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_5_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Item 6 -->
                <LinearLayout
                    android:id="@+id/quick_pick_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_6_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_6_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Item 7 -->
                <LinearLayout
                    android:id="@+id/quick_pick_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/quick_pick_7_art"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/widget_item_placeholder"
                        android:contentDescription="@string/widget_artwork"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/quick_pick_7_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#D9FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
