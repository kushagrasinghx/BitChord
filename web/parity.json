{
  "$comment": "Android feature -> its web counterpart (web/scripts/parity.mjs). `shared`: shared/commonMain code both run, so that part follows Android by itself. A PR that changes a feature's `android` files without its `web` or `shared` ones gets a warning naming where the web side lives. Paths are checked to exist on every PR.",
  "features": [
    {
      "id": "best-part",
      "name": "Best Part (most-replayed start)",
      "android": ["sharedUi/src/jvmSharedMain/kotlin/com/music/bitchord/ui/player/PlayerControls.kt", "app/src/main/java/com/music/bitchord/ui/replay/year/BestParts.kt"],
      "web": ["web/app/src/lib/sharedKotlin.test.ts"],
      "shared": ["shared/src/commonMain/kotlin/com/music/bitchord/ui/replay/year/BestPart.kt"]
    },
    {
      "id": "playlist-order",
      "name": "Playlist reordering (fewest moves)",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/innertube/Innertube.kt"],
      "web": ["web/app/src/lib/sharedKotlin.test.ts"],
      "shared": ["shared/src/commonMain/kotlin/com/music/bitchord/data/model/PlaylistOrder.kt"]
    },
    {
      "id": "artwork",
      "name": "Artwork renditions",
      "android": ["app/src/main/java/com/music/bitchord/data/YouTubeThumbnailFallback.kt"],
      "web": ["web/app/src/lib/artwork.ts"],
      "shared": ["shared/src/commonMain/kotlin/com/music/bitchord/data/model/Models.kt"]
    },
    {
      "id": "queue-timeline",
      "name": "Queue timeline (jumps, sections)",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/playback/QueueTimeline.kt", "shared/src/jvmSharedMain/kotlin/com/music/bitchord/playback/QueueSections.kt"],
      "web": ["web/app/src/playback/queue/timeline.ts"]
    },
    {
      "id": "queue-builder",
      "name": "Queue building",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/playback/QueueBuilder.kt"],
      "web": ["web/app/src/playback/queue/builder.ts"]
    },
    {
      "id": "track-matching",
      "name": "Song matching (accents, CJK romanization)",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/sources/TrackMatcher.kt"],
      "web": ["web/app/src/data/match/trackMatcher.ts"]
    },
    {
      "id": "artist-credits",
      "name": "Artist bylines",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/model/ArtistCredits.kt"],
      "web": ["web/app/src/lib/artistCredits.ts"]
    },
    {
      "id": "lyric-clock",
      "name": "Lyric clock (karaoke sweep, pause and resume)",
      "android": ["sharedUi/src/jvmSharedMain/kotlin/com/music/bitchord/ui/player/LyricClock.kt"],
      "web": ["web/app/src/lyrics/clock.ts"]
    },
    {
      "id": "lyrics-sources",
      "name": "Lyrics providers and parsing",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/lyrics/"],
      "web": ["web/app/src/lyrics/parse.ts", "web/app/src/lyrics/providers.ts", "web/app/src/lyrics/youtube.ts", "web/app/src/lyrics/ttml.ts"]
    },
    {
      "id": "stream-resolution",
      "name": "YouTube stream resolution (client order)",
      "android": ["shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/innertube/StreamResolver.kt", "shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/innertube/InnerTubeXResolver.kt"],
      "web": ["web/app/src/playback/youtube/resolver.ts"]
    },
    {
      "id": "listen-together",
      "name": "Listen Together (party models, clock, invites)",
      "android": ["shared/src/commonMain/kotlin/com/music/bitchord/data/listentogether/"],
      "web": ["web/app/src/party/"]
    },
    {
      "id": "loop-mix",
      "name": "AutoMix loop mix",
      "android": ["shared/src/commonMain/kotlin/com/music/bitchord/playback/smart/LoopMix.kt"],
      "web": ["web/app/src/playback/automix/engine/loopMix.ts"]
    }
  ]
