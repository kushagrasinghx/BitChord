<?xml version="1.0" encoding="utf-8"?>
<!--
  The 3×3 recognition pill: a polished curved rectangle with the sheet's
  waveform on
  it — white bars in the round shapes the sheet draws them in, with nothing
  behind them to frame them.

  - sleeping: [ic_widget_wave_sleep], wired at add time and after every take
    ends; the widget reads as an object at rest;
  - listening: RecognitionActivity renders the same arithmetic the sheet's
    LiveWaveform draws — phase-breathing idle heights, level-driven rises —
    and pushes the frames here through [RecognitionWidgetProvider.showWave].

  There is no text and no separate mic anywhere: the waveform on the pill is
  the whole vocabulary.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      Keep the pill centered inside its 3×3 host so the square widget has
      breathing room around the curved rectangle.
    -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_recognition_background">

        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_recognition_label"
            android:src="@drawable/ic_widget_wave_sleep"
            android:scaleType="fitXY" />
    </FrameLayout>
</FrameLayout>
