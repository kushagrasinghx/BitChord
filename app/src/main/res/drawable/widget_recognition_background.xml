<?xml version="1.0" encoding="utf-8"?>
<!--
  The recognition widget's body: a dark, softly graduated capsule with a
  restrained outline so it reads as a deliberate card in the launcher picker
  and on the home screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="32dp" />
    <gradient
        android:angle="135"
        android:centerColor="#FF151B22"
        android:endColor="#FF080A0D"
        android:startColor="#FF29323D" />
    <stroke
        android:width="1dp"
        android:color="#45FFFFFF" />
</shape>
