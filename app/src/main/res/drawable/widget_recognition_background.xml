<?xml version="1.0" encoding="utf-8"?>
<!--
  The recognition widget's body: a dark, softly graduated rounded card with a
  restrained outline so the wide 3×2 surface reads as deliberate in the
  launcher picker and on the home screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:angle="135"
        android:centerColor="#FF151B22"
        android:endColor="#FF080A0D"
        android:startColor="#FF29323D" />
    <stroke
        android:width="1dp"
        android:color="#45FFFFFF" />
</shape>
