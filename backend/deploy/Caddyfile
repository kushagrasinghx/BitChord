{
	servers {
		timeouts {
			idle 5m
		}
		# The domain is proxied through Cloudflare, so the peer is a Cloudflare
		# edge, shared by many users. Take the client from CF-Connecting-IP, but
		# only when the peer really is Cloudflare, or anyone could set the header.
		# Ranges from https://www.cloudflare.com/ips/ (checked 2026-10-17).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	# Over 90% of requests are the apps' /healthz probe. Answer it here instead
	# of proxying it: no upstream dial, no extra goroutine and buffers per probe.
	# The apps only check for a 2xx whose body contains "ok":true.
	handle /healthz {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"ok":true}` 200
	}
	handle {
		reverse_proxy 127.0.0.1:8000 {
			# The Go server rate-limits by the first X-Forwarded-For entry
			# (JAM_TRUST_PROXY). Send exactly the resolved client, never a
			# chain that starts with whatever the caller wrote.
			header_up X-Forwarded-For {client_ip}
		}
	}
}
