{
	servers {
		timeouts {
			idle 5m
		}
	}
}

{$DOMAIN} {
	# Over 90% of requests are the apps' /healthz probe. Answer it here instead
	# of proxying it: no upstream dial, no extra goroutine and buffers per probe.
	# The apps only check for a 2xx whose body contains "ok":true.
	handle /healthz {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"ok":true}` 200
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
