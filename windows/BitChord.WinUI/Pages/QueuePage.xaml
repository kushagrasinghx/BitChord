<Page x:Class="BitChord.WinUI.Pages.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="44,38,44,120">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Up next" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="4 tracks in your queue" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,6,0,30"/>
            <Border Style="{StaticResource GlassCard}" Padding="12">
                <StackPanel>
                    <TextBlock Text="NOW PLAYING" FontSize="11" Foreground="{ThemeResource AccentBrush}" Margin="8,6,8,14"/>
                    <Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="10" Background="#4A8D6BFF"><TextBlock Text="♫" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="Midnight City" FontWeight="SemiBold"/><TextBlock Text="M83" Foreground="{ThemeResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="3:03" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"/></Grid>
                    <TextBlock Text="NEXT" FontSize="11" Foreground="{ThemeResource AccentBrush}" Margin="8,20,8,8"/>
                    <TextBlock Text="The Mother We Share                                  3:13" Padding="8" Margin="0,0,0,6"/>
                    <TextBlock Text="Intro                                                   2:07" Padding="8" Margin="0,0,0,6"/>
                    <TextBlock Text="Nightcall                                               4:18" Padding="8"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
