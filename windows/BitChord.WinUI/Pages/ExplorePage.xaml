<Page x:Class="BitChord.WinUI.Pages.ExplorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="44,38,44,120">
        <StackPanel MaxWidth="1100">
            <TextBlock Text="Explore" FontSize="34" FontWeight="SemiBold"/>
            <TextBox PlaceholderText="Search artists, albums, songs and playlists" Margin="0,22,0,30" Height="48"/>
            <TextBlock Text="Made for you" Style="{StaticResource SectionTitle}"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Focus Flow" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ambient electronic for deep work" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,8,0,22"/><Button Content="Play" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Late Night" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Soft lights, slow rhythms" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,8,0,22"/><Button Content="Play" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Discover Weekly" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="30 tracks picked for you" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,8,0,22"/><Button Content="Play" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
