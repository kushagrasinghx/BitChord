<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming; this just gives an edge-to-edge, action-bar-free window. -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- TV theme for edge-to-edge landscape remote experience -->
    <style name="Theme.BitChord.Tv" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
