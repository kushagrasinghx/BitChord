<Page x:Class="BitChord.WinUI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer Padding="44,38,44,120">
        <StackPanel MaxWidth="1100">
            <TextBlock Text="Good evening, Alex" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="Find your next favorite sound." FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,6,0,30"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,14,0" MinHeight="230">
                    <Grid>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="YOUR DAILY MIX" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"/>
                            <TextBlock Text="A little bit of everything" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock Text="M83, CHVRCHES, The xx and more" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <Button Content="Play mix" HorizontalAlignment="Left" Margin="0,22,0,0" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                        <TextBlock Text="✦" FontSize="128" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource AccentBrush}"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Background="#503F377A">
                    <StackPanel>
                        <TextBlock Text="LISTENING STATS" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="12h 42m" FontSize="32" FontWeight="SemiBold" Margin="0,15,0,0"/>
                        <TextBlock Text="this week" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <ProgressBar Value="68" Margin="0,22,0,0"/>
                        <TextBlock Text="You're on a 6 day streak" Margin="0,12,0,0" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Jump back in" Style="{StaticResource SectionTitle}" Margin="0,34,0,14"/>
            <muxc:ItemsRepeater x:Name="RecentTracks">
                <muxc:ItemsRepeater.Layout><muxc:StackLayout Orientation="Horizontal" Spacing="14"/></muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Width="190" Padding="14">
                            <StackPanel>
                                <Border Height="150" CornerRadius="14" Background="#3D8D6BFF">
                                    <TextBlock Text="♫" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,12,0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
