<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@array/android_wear_capabilities">
    <!--
      How the BitChord watch app (wearos/) finds this phone. Must match
      WearProtocol.CAPABILITY_PHONE. Only the watch app of the same package and
      signing key ever sees it, so dev pairs with dev and prod with prod.
    -->
    <string-array name="android_wear_capabilities" translatable="false">
        <item>bitchord_phone</item>
    </string-array>
</resources>
