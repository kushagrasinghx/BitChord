<?xml version="1.0" encoding="utf-8"?>
<!--
  Press feedback for a transport button. Masked to an oval so the ripple reads as
  a circle around the glyph rather than as a square lighting up over the artwork
  — the same shape the IconButtons in the mini player get for free from Material.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
