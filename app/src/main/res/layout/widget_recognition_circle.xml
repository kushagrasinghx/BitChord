<?xml version="1.0" encoding="utf-8"?>
<!--
  The compact recognition widget: one circular touch target with the same
  five-bar waveform used by the pill. RecognitionActivity replaces widget_wave
  with measured frames while the microphone is listening.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_recognition_circle_background">

        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="48dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_recognition_label"
            android:src="@drawable/ic_widget_wave_sleep"
            android:scaleType="fitCenter" />
    </FrameLayout>
</FrameLayout>
